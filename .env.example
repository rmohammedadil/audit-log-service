# Copy to .env and replace every placeholder. Do not commit .env.
AUDIT_JWT_SIGNING_KEY=replace-with-a-random-secret-at-least-32-characters
AUDIT_JWT_ISSUER=audit-local
AUDIT_JWT_AUDIENCE=audit-api
AUDIT_RETENTION_DAYS=90
# Compose supplies AUDIT_V4_DB_PATH=/var/lib/audit-v4/audit_log_v4.db.
# Do not set AUDIT_DB_PATH for the supported V4 container deployment.
# Optional signing override only:
# AUDIT_EXPORT_PRIVATE_KEY_HOST_PATH=C:/secure-path/export-private.pem
